[Unit]
Description=AlgoTrade backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/algotrade/backend
ExecStart=/opt/algotrade/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StartLimitIntervalSec=0
EnvironmentFile=/opt/algotrade/backend/.env

[Install]
WantedBy=multi-user.target
